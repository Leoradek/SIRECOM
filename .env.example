# ============================================================
# SIRECOM - Variables de entorno (referencia global del monorepo)
# Copia server/.env.example -> server/.env y client/.env.example -> client/.env
# NO subas archivos .env reales al repositorio.
# ============================================================

# ---------- BACKEND (server/.env) ----------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sirecom
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_de_32_o_mas_caracteres
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
CLIENT_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=uab.edu.bo
APP_TIMEZONE=America/La_Paz
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIRECOM <no-reply@uab.edu.bo>"
ENABLE_REMINDERS=true
PROJECTION_WALKIN_FACTOR=0.19
MAX_ADVANCE_DAYS=7

# ---------- FRONTEND (client/.env) ----------
VITE_API_URL=http://localhost:5000/api
