# ============================================================
# SIRECOM - Backend (server/.env)
# Copia este archivo a ".env" y completa los valores.
# ============================================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor Express
PORT=5000

# Cadena de conexión a MongoDB (local o Atlas).
# Local : mongodb://127.0.0.1:27017/sirecom
# Atlas : mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/sirecom?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sirecom

# Secreto para firmar los JWT (mínimo 32 caracteres aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_de_32_o_mas_caracteres

# Vigencia del JWT (formato jsonwebtoken: 15m, 2h, 1d, 7d...)
JWT_EXPIRES_IN=1d

# Costo del hash Bcrypt (el sistema fuerza un mínimo de 10)
BCRYPT_SALT_ROUNDS=10

# Origen(es) permitidos por CORS (separados por coma)
CLIENT_URL=http://localhost:5173

# Dominios de correo institucional permitidos (separados por coma)
ALLOWED_EMAIL_DOMAINS=uab.edu.bo

# Zona horaria para calcular "hoy" y la hora de inicio/fin de turnos
APP_TIMEZONE=America/La_Paz

# OTP: vigencia en minutos e intentos máximos antes de exigir un nuevo código
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# SMTP (opcional). Si SMTP_HOST está vacío, los correos (incluido el OTP)
# se imprimen en la consola del servidor (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIRECOM <no-reply@uab.edu.bo>"

# Recordatorios automáticos por correo (RF-010): true | false
ENABLE_REMINDERS=true

# Factor de comensales sin reserva esperados para la proyección del dashboard
# comensalesProyectados = round(cuposReservados * (1 + factor))
PROJECTION_WALKIN_FACTOR=0.19

# Máximo de días de anticipación para reservar
MAX_ADVANCE_DAYS=7
